# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Stockwell
APP_KEY=
APP_ENV=production
APP_URL=https://your-domain.example/backend

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=mydb
# Optional: absolute path to the MySQL provider's CA certificate to enable TLS with certificate verification.
DB_SSL_CA=

# LavaLust API helper configuration (generate independent random values of 32+ characters)
API_JWT_SECRET=
API_REFRESH_TOKEN_KEY=
API_ALLOW_ORIGIN=

# SMTP notifications and password recovery (never commit these secrets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM=mannymanuelxx@gmail.com
SMTP_FROM_NAME=Stockwell
APP_FRONTEND_URL=https://your-domain.example/frontend
