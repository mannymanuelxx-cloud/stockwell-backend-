# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Stockwell
APP_KEY=
APP_ENV=production
APP_URL=https://your-domain.example/backend

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=mydb
# Optional: absolute path to the MySQL provider's CA certificate to enable TLS with certificate verification.
DB_SSL_CA=

# LavaLust API helper configuration (generate independent random values of 32+ characters)
API_JWT_SECRET=
API_REFRESH_TOKEN_KEY=
API_ALLOW_ORIGIN=

# Google OAuth customer sign-in. See docs/google-oauth-setup.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://stockwell-api-nlyi.onrender.com/api/auth/google/callback

# Optional bot protection for customer registration. Set both keys to enable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional GA4 web stream measurement ID; enables consent-gated page views only.
GA4_MEASUREMENT_ID=

# Brevo transactional email (recommended for Render Free). Verify the sender in
# Brevo before using it. When BREVO_API_KEY is set, Brevo API takes precedence.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Stockwell
BREVO_REPLY_TO=
BREVO_REPLY_TO_NAME=Stockwell

# Optional SMTP fallback if BREVO_API_KEY is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM=mannymanuelxx@gmail.com
SMTP_FROM_NAME=Stockwell
APP_FRONTEND_URL=https://your-domain.example/frontend
